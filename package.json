{
  "name": "search",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "watch": "tsx scripts/build.ts --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0 --no-warn-ignored",
    "lint:fix": "npm run lint -- --fix",
